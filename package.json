{
  "name": "test-portal",
  "private": true,
  "version": "1.3.3",
  "description": "Academic 3D Test Portal desktop application",
  "author": "Anatomyzh Team",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist \"test portal\"",
